<?xml version="1.0" encoding="utf-8"?>
<diff>
  <add sel="//add_build_to_modify_ship[@object='$destination_station_interrupt']" pos="before">
    <!-- Cargo Teleportation: an own ship restocking from an own supply ship gets the Restock order instead of the build (research) -->
    <include_interrupt_actions ref="CargoTeleportation_Restock" />
  </add>
  <add sel="//add_build_to_modify_ship[@object='$destination_station_interrupt']" type="@chance">if @$ctRestocking then 0 else 100</add>
  <add sel="//add_build_to_modify_ship[@object='$destination_station_interrupt']" pos="after">
    <!-- Cargo Teleportation: an own supply ship short of the build's resources gets GetSupplies at once (option) -->
    <include_interrupt_actions ref="CargoTeleportation_RequestSupplies" />
  </add>
  <add sel="//do_if[@value='not $build_interrupt']" type="@chance">if @$ctRestocking then 0 else 100</add>
  <add sel="//do_if[@value='not $build_interrupt']" pos="after">
    <remove_value name="$ctRestocking" />
  </add>
</diff>
